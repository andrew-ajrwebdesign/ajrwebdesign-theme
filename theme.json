{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"custom": {
			"radius": {
				"sm": "6px",
				"md": "12px",
				"lg": "20px"
			},
			"header": {
				"offset": "85px"
			},
			"shadow": {
				"dropdown": "var(--wp--preset--shadow--soft)"
			}
		},
		"shadow": {
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 12px 30px -12px rgba(15, 23, 42, 0.18)"
				}
			]
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "bg", "color": "#ffffff", "name": "Background" },
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "surface", "color": "#f8fafc", "name": "Surface" },
				{ "slug": "ink", "color": "#0f172a", "name": "Ink" },
				{ "slug": "contrast", "color": "#0f172a", "name": "Contrast" },
				{ "slug": "muted", "color": "#64748b", "name": "Muted" },
				{ "slug": "border", "color": "#e2e8f0", "name": "Border" },
				{ "slug": "dark", "color": "#071a2f", "name": "Dark" },
				{ "slug": "dark-soft", "color": "#0b2540", "name": "Dark Soft" },
				{ "slug": "primary", "color": "#0f766e", "name": "Primary" },
				{ "slug": "accent", "color": "#0e7f56", "name": "Accent" },
				{ "slug": "accent-dark", "color": "#06634c", "name": "Accent Dark" },
				{ "slug": "warning", "color": "#f59e0b", "name": "Warning" }
			],
			"gradients": [
				{
					"slug": "button-green",
					"name": "Button Green",
					"gradient": "linear-gradient(90deg, #06634C 0%, #0E7F56 100%)"
				},
				{
					"slug": "hero-dark",
					"name": "Hero Dark",
					"gradient": "linear-gradient(135deg, #071a2f 0%, #0b2540 55%, #0f766e 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "noto-sans",
					"name": "Noto Sans",
					"fontFamily": "\"Noto Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Sans",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/NotoSans-wght.woff2" ]
						}
					]
				},
				{
					"slug": "lora",
					"name": "Lora",
					"fontFamily": "\"Lora\", serif",
					"fontFace": [
						{
							"fontFamily": "Lora",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Lora-wght.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "Extra Small", "size": "0.875rem" },
				{ "slug": "sm", "name": "Small", "size": "0.95rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "lg", "name": "Large", "size": "1.125rem" },
				{ "slug": "xl", "name": "Extra Large", "size": "1.375rem" },
				{ "slug": "2-xl", "name": "2X Large", "size": "1.75rem" },
				{ "slug": "3-xl", "name": "3X Large", "size": "2.25rem" },
				{ "slug": "4-xl", "name": "4X Large", "size": "3rem" },
				{ "slug": "small", "name": "Small (compat)", "size": "13px", "fluid": false },
				{ "slug": "normal", "name": "Normal (compat)", "size": "16px", "fluid": false },
				{ "slug": "medium", "name": "Medium (compat)", "size": "20px" },
				{ "slug": "large", "name": "Large (compat)", "size": "36px" },
				{ "slug": "x-large", "name": "X-Large (compat)", "size": "42px" },
				{ "slug": "huge", "name": "Huge (compat)", "size": "42px", "fluid": false }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"steps": 8,
				"mediumStep": 1.25
			},
			"units": [ "px", "rem", "em", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--noto-sans)",
			"fontSize": "1rem",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)",
					"fontWeight": "400",
					"lineHeight": "1.125",
					"letterSpacing": "-0.1px"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "50px"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "44px"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--noto-sans)",
					"fontSize": "1.25rem",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1rem",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "0.95rem"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "0.875rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"gradient": "var(--wp--preset--gradient--button-green)",
					"text": "#ffffff"
				},
				"typography": {
					"fontSize": "16px",
					"fontWeight": "500",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)"
					}
				}
			},
			"list": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		},
		"blocks": {
			"core/columns": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "16px"
				}
			},
			"core/list": {
				"css": "& li{margin-top: 0.5rem;}"
			},
			"core/button": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"gradient": "var(--wp--preset--gradient--button-green)",
					"text": "#ffffff"
				},
				"typography": {
					"fontSize": "16px",
					"fontWeight": "500"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--noto-sans)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--radius--lg)"
				}
			},
			"core/group": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--ink)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--ink)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary)"
							}
						}
					}
				}
			},
			"core/separator": {
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--primary)",
					"style": "solid",
					"width": "0",
					"left": {
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/table": {
				"border": {
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "1px"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
